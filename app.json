{
    "expo": {
        "name": "Planly",
        "slug": "Planly",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/planly_icon_symbol_only.png",
        "scheme": "planly",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.arj.planly",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.arj.planly"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-sqlite",
            [
                "expo-notifications",
                {
                    "icon": "./assets/images/planly_icon_symbol_only.png",
                    "color": "#59008c",
                    "sounds": []
                }
            ],
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-planly.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "7d194de4-78a5-4f22-a9dd-a479cafbda7c"
            }
        }
    }
}
