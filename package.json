{
    "name": "planly",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "sh -c \"[ -d ios ] || { echo 'No ios directory. If this is an Expo managed project run: npx expo prebuild --platform ios'; exit 1; } && [ -f ios/Podfile ] || { echo 'No Podfile found in ios/. If using Expo managed workflow run: npx expo prebuild --platform ios'; exit 1; } && cd ios && rm -rf Pods Podfile.lock && pod install && cd .. && expo run:ios\"",
        "ios:clean": "sh -c \"[ -d ios ] || { echo 'No ios directory to clean'; exit 1; } && cd ios && rm -rf Pods Podfile.lock && pod install && cd ..\"",
        "pods": "sh -c \"[ -d ios ] || npx expo prebuild --platform ios; cd ios && pod install\"",
        "web": "expo start --web"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.0.3",
        "@gorhom/bottom-sheet": "^5.2.8",
        "@react-native-async-storage/async-storage": "^2.1.0",
